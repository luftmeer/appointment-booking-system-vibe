# These values are public local-development defaults, not secrets. Do not use
# them in production or reuse them in another project.
# Compose loads `.env` automatically. For host commands using these overrides,
# run `uv run --env-file .env pytest` or `uv run --env-file .env python ...`.
DJANGO_ENVIRONMENT=development
DJANGO_SECRET_KEY=development-only-appointment-booking-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Host commands connect through the loopback-published PostgreSQL port.
# The web container overrides DATABASE_HOST to postgres and DATABASE_PORT to 5432.
DATABASE_NAME=appointment_booking_development
DATABASE_USER=appointment_booking_development
DATABASE_PASSWORD=development-only-appointment-booking-database-password
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_TEST_NAME=appointment_booking_test
DATABASE_CONNECT_TIMEOUT=2
# Integer from 1 through 1000.
DATABASE_STARTUP_MAX_ATTEMPTS=10
# Delay in seconds, as an integer from 0 through 300.
DATABASE_STARTUP_RETRY_DELAY=1

# Compose bind addresses are fixed to 127.0.0.1 and cannot be overridden.
# DATABASE_PORT selects the PostgreSQL host port; the container always uses 5432.
WEB_HOST_PORT=8000
